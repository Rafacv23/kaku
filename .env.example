# Local development needs none of these: `bun dev` runs against the Docker
# database and prints sign-in codes to the console. Copy to `.env` only to
# override a default. Deployed environments set them in Vercel.

# libSQL / Turso database. Defaults to the local Docker server.
DATABASE_URL=http://127.0.0.1:8080
DATABASE_AUTH_TOKEN=

# Signs sessions. Required outside development: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://kaku.example. Defaults to the request origin in development.
BETTER_AUTH_URL=

# Google sign-in is offered only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
